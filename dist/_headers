/*
  # HTTPS & Transport Security
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Content Security & Framing
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Browser Feature Restrictions
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=()
  
  # Content Security Policy (Optimized for client-side tools, DoH DNS, and Google Fonts)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' blob: https://dns.google https://cloudflare-dns.com https://rdap.org; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self';
